{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPod|Android.*Mobile|Windows Phone|Mobi).*" }],
      "missing": [{ "type": "query", "key": "desktop" }],
      "destination": "/mobile/",
      "permanent": false
    },
    { "source": "/mobile", "destination": "/mobile/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Wedding%20website%20planning/The%20Gallery%203D.html" },
    { "source": "/gallery3d.js", "destination": "/Wedding%20website%20planning/gallery3d.js" },
    { "source": "/favicon.ico", "destination": "/Wedding%20website%20planning/assets/icons/favicon.ico" },
    { "source": "/apple-touch-icon.png", "destination": "/Wedding%20website%20planning/assets/icons/apple-touch-icon.png" },
    { "source": "/assets/:path*", "destination": "/Wedding%20website%20planning/assets/:path*" },
    { "source": "/game/:path*", "destination": "/Wedding%20website%20planning/game/:path*" },
    { "source": "/mobile/", "destination": "/Wedding%20website%20planning/mobile/index.html" },
    { "source": "/mobile/:path*", "destination": "/Wedding%20website%20planning/mobile/:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }] },
    { "source": "/mobile/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }] }
  ]
}
